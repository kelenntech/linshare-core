<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation=" http://www.springframework.org/schema/beans
	http://www.springframework.org/schema/beans/spring-beans-4.1.xsd">

	<import resource="OPTIONAL-springContext-storage-jcloud.xml" />

	<!--
		Must be named rawFileDataStore, like every storage profile:
		springContext-storage-encryption.xml (always loaded) defines
		fileDataStore on top of it, and the context fails to start without it.
	-->
	<bean id="rawFileDataStore"
		class="org.linagora.linshare.core.dao.impl.WrapperFileDataStoreImpl">
		<constructor-arg ref="jcloudFileDataStore" />
	</bean>

</beans>
